<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="SmokeTesting" verbose="1">

    <test name="Smoke" preserve-order="true">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="org.test.tests.RegisterTest"/>
            <class name="org.test.tests.LoginTest"/>
            <class name="org.test.tests.GeolocationTest"/>
            <class name="org.test.tests.OrderingTest"/>
            <class name="org.test.tests.CheckoutTest"/>
        </classes>
    </test>

</suite>